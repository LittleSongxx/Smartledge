# smartledge 本地部署参数模板。
#
# 用法：复制为 .env 并填入自己的凭据。.env 已被 .gitignore 忽略。
#   cp .env.example .env
#
# 三处消费点：
#   1. Java 应用   —— 通过 application.yaml 的 spring.config.import 直接读取（从仓库根目录启动时生效）
#   2. Python 服务 —— 通过 deploy/start-rag-tools.sh 以环境变量注入
#   3. 依赖栈      —— docker compose --env-file .env -f deploy/docker-compose.yml
#
# 格式要求：KEY=value，等号两侧不留空格，值不加引号，行首 # 为注释。
# 这样同一份文件既能被 shell source，也能被 Spring 当作 properties 解析。

# ============================================================================
# 模型服务（必需）
# ============================================================================

# 阿里云百炼密钥。Java 侧对话与向量化、Python 侧 GraphRAG 抽取与 RAPTOR 摘要共用。
# 取值方式：百炼控制台 -> API-KEY 管理。
ALI_BAI_LIAN_API_KEY=sk-your-dashscope-api-key

# 对话端点。默认走公共 compatible-mode；使用百炼 MAAS 专属网关或自建兼容服务时，
# 在 .env 里设置下面两项（Java 与 Python 必须指向同一网关）。取消注释即可生效。
# SMARTLEDGE_CHAT_BASE_URL=https://<your-maas-endpoint>.maas.aliyuncs.com/compatible-mode/
# RAG_TOOLS_LLM_BASE_URL=https://<your-maas-endpoint>.maas.aliyuncs.com/compatible-mode/v1

# Tavily 联网搜索密钥，仅用于「开放式提问」的 ReAct Agent 联网检索。
# 留空或删除时该工具在调用报「Tavily API Key 未配置」，其余功能不受影响。
# 不影响应用启动。
# TAVILY_API_KEY=

# ============================================================================
# 文档解析（PDF / DOCX / XLSX / 图片需要；TXT / MD / HTML 不需要）
# ============================================================================

# 阿里云 Document Mind 的 AK/SK。未配置时这些格式的解析返回 503，
# TXT/Markdown/HTML 走本地解析器不受影响。
ALIBABA_CLOUD_ACCESS_KEY_ID=your-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-access-key-secret

# Document Mind 服务区域，默认杭州。换区域时才需要取消注释。
# RAG_TOOLS_ALIYUN_DOCMIND_ENDPOINT=docmind-api.cn-hangzhou.aliyuncs.com

# ============================================================================
# 本地模型（向量化与重排，本地推理，不需要密钥）
# ============================================================================

# 向量化模型。维度必须是 1024：Java 侧严格校验返回维度，pgvector 列已归一化为 vector(1024)。
# 换模型必须同时满足该维度。已知可用的 1024 维模型：BAAI/bge-m3、Qwen/Qwen3-Embedding-0.6B。
# 注意 BAAI/bge-small-zh-v1.5 是 512 维，不能直接替换。
RAG_TOOLS_EMBEDDING_MODEL=BAAI/bge-m3

# 重排模型，本地 cross-encoder 推理。
RAG_TOOLS_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 强制离线，直接使用本机 HF 缓存，避免启动时的远端探测。
# 首次使用需先在有网环境下载模型，或临时关闭这两项完成一次下载。
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ============================================================================
# 本地服务端口
# ============================================================================

# Python rag-tools 监听地址。数据库配置 ragTools.baseUrl 必须与此一致。
RAG_TOOLS_HOST=127.0.0.1
RAG_TOOLS_PORT=18089

# ============================================================================
# 本地依赖栈口令（必须与 deploy/docker-compose.yml 的默认值一致，否则连不上）
# 仅本机开发用途；生产环境必须替换为独立强口令并通过密钥管理下发。
# ============================================================================

SMARTLEDGE_MYSQL_PASSWORD=smartledge
SMARTLEDGE_PG_PASSWORD=smartledge
SMARTLEDGE_REDIS_PASSWORD=smartledge
SMARTLEDGE_RABBITMQ_USER=smartledge
SMARTLEDGE_RABBITMQ_PASSWORD=smartledge
SMARTLEDGE_MINIO_USER=smartledge
SMARTLEDGE_MINIO_PASSWORD=smartledge123
NEO4J_PASSWORD=smartledge2026

# 本部署栈的 Elasticsearch 关闭了 security 模块，该口令实际不参与校验，
# 保留它只为兼容 application.yaml 的读取。
ELASTICSEARCH_PASSWORD=elastic
